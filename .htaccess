Options -Indexes
DirectoryIndex index.php

<Files "config.json">
    Require all denied
</Files>

<Files "catalog.json">
    Require all denied
</Files>

<FilesMatch "^(lib\.php|config\.example\.json|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>

# Backups and temporary copies (config.json.bak holds the admin token).
<FilesMatch "\.(bak|tmp)$">
    Require all denied
</FilesMatch>

# Dot files and folders (.git, .github, .gitignore) and the test suite are
# never served; .well-known stays reachable for SSL certificates.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
    RewriteRule "^tests(/|$)" - [F,L]
</IfModule>
